rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and manage their own profiles and caregiver lookups
    match /users/{userId} {
      allow read, write: if true;
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    // Memory Journals collection - Strictly isolated to assigned Patient-Caregiver relationship
    match /journals/{journalId} {
      allow read: if request.auth == null || (
        resource.data.patient_id == request.auth.uid ||
        resource.data.caregiver_id == request.auth.uid ||
        resource.data.created_by == request.auth.uid
      );
      allow create: if request.auth == null || (
        request.resource.data.created_by == request.auth.uid ||
        request.resource.data.patient_id == request.auth.uid ||
        request.resource.data.caregiver_id == request.auth.uid
      );
      allow update, delete: if request.auth == null || (
        resource.data.created_by == request.auth.uid ||
        resource.data.patient_id == request.auth.uid ||
        resource.data.caregiver_id == request.auth.uid
      );
    }

    // Family members collection
    match /family_members/{memberId} {
      allow read, write: if true;
    }

    // Cognitive game sessions collection
    match /game_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Cognitive game level progression collection
    match /game_progress/{progressId} {
      allow read, write: if true;
    }

    // Caregiver and elderly connections
    match /caregiver_links/{linkId} {
      allow read, write: if true;
    }

    // Emergency and cognitive alerts
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // Health check and connectivity validation collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
